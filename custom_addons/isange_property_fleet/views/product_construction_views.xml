<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_inherit_isange" model="ir.ui.view">
        <field name="name">product.template.form.inherit.isange.construction</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Construction &amp; Delivery" name="isange_construction">
                    <group>
                        <group string="Construction Item Classification">
                            <field name="is_construction_item"/>
                            <field name="construction_category" invisible="not is_construction_item"/>
                        </group>
                        <group string="Delivery &amp; Wholesale Packaging" invisible="not is_construction_item">
                            <field name="unit_weight_kg"/>
                            <field name="bulk_pack_qty"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
