# Exclude non-runtime files from Vercel deployment bundles
.git
.github
.gitignore
.venv
venv
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache
.env
.env.*
!.env.example
odoo-19.0.tar.gz

# Odoo docs, packaging, and test assets not needed at runtime
doc
debian
setup
**/tests
**/static/tests
# Exclude non-English .po translation files (~875 MB across 400+ addons!).
# English (en_US) is built directly into source files and needs NO .po files.
# This shrinks the ENTIRE 400+ addon Odoo 19 codebase to ~187 MB so it fits
# inside Vercel's default 500 MB Python bundle limit without deleting any addons!
# To include a specific language (e.g. French), add `!**/*/i18n/fr.po` below
# (or remove `**/*.po` and set VERCEL_SUPPORT_LARGE_FUNCTIONS=1 in Vercel).
**/*.po
README*.md
LICENSE
COPYRIGHT
CONTRIBUTING.md
SECURITY.md
Makefile
requirements.odoo.txt

# Local helper scripts & SQL migrations
scripts
supabase

# Exclude heavy unused addons from the Vercel function bundle to keep total
# uncompressed bundle size comfortably below Vercel's 225 MB cap while keeping
# Isange Hardware ERP (Sales, Pro-Forma, Invoicing, POS, Stock, Purchase,
# Fleet, Maintenance, Expenses, Contacts, Portal) and l10n_* intact.
addons/spreadsheet
addons/spreadsheet_*
addons/website_slides
addons/website_slides_*
addons/website_hr_recruitment
addons/website_blog
addons/website_event
addons/website_event_*
addons/website_forum
addons/mass_mailing
addons/mass_mailing_*
addons/mrp
addons/mrp_*
addons/survey
addons/survey_*
addons/hr_recruitment
addons/hr_recruitment_*
addons/hr_timesheet
addons/hr_attendance
addons/project
addons/project_*
addons/pos_self_order
addons/im_livechat
addons/event
addons/event_*
addons/gamification
addons/gamification_*
addons/marketing_card
addons/lunch
