# sphinx build directories
_build/

# dotfiles
.*
!.gitignore
!.gitkeep
!.github
!.mailmap
!.weblate.json
!.vercelignore
!.python-version
!.env.example

# Local secrets & environment overrides (never commit!)
.env
.env.*
!.env.example

# Exclude non-English .po translation files (~875 MB) and test/demo fixtures
# so GitHub pushes and Vercel deployments stay fast and under Vercel's 500 MB limit.
# English (en_US) is built into Odoo source files; to track a specific language,
# un-ignore it below (e.g. `!**/i18n/fr.po`).
**/*.po
**/tests/
**/static/tests/
# compiled python files
*.py[co]
__pycache__/
# setup.py egg_info
*.egg-info
# emacs backup files
*~
# hg stuff
*.orig
status
# odoo filestore
odoo/filestore
# maintenance migration scripts
odoo/addons/base/maintenance
# windows installation config file
/odoo.conf

# generated for windows installer?
install/win32/*.bat
install/win32/meta.py

# needed only when building for win32
setup/win32/static/less/
setup/win32/static/wkhtmltopdf/
setup/win32/static/postgresql*.exe

# js tooling
node_modules
jsconfig.json
tsconfig.json
package-lock.json
package.json
.husky

# various virtualenv
/bin/
/build/
/dist/
/include/
/lib/
/man/
/share/
/src/
