# =============================================================================
# Odoo 19 Community Edition — Vercel + Supabase Environment Variables
# Copy to .env for local usage or configure in Vercel Project Settings -> Env Vars
# =============================================================================

# --- 1. Supabase PostgreSQL Connection (REQUIRED) ----------------------------
# IMPORTANT: Use Supabase's SESSION POOLER (port 5432, IPv4-compatible) — NOT
# the Transaction Pooler (port 6543) and NOT the IPv6-only Direct host unless
# you have the Supabase IPv4 add-on enabled.
# Example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Alternatively, set individual parameters instead of DATABASE_URL:
# SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_PASSWORD=your-supabase-db-password
# SUPABASE_DB_SSLMODE=require

# --- 2. Supabase Storage Filestore (RECOMMENDED) -----------------------------
# Modes:
#   supabase -> store attachments & compiled assets in Supabase Storage (+ /tmp cache)
#   db       -> store attachments & compiled assets directly in Supabase PostgreSQL
# If omitted on Vercel, defaults to `supabase` when SUPABASE_URL + key are set, else `db`.
ODOO_FILESTORE_MODE=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=odoo-filestore

# --- 3. Vercel Fluid Compute Large Functions (OPTIONAL) ----------------------
# By default `.vercelignore` and `vercel.json` exclude non-English `.po` files
# (~875 MB), keeping ALL 400+ Odoo 19 Community addons at ~187 MB (well within
# Vercel's standard 500 MB Python function limit).
# Only set VERCEL_SUPPORT_LARGE_FUNCTIONS=1 if you re-enable all `.po`
# translation files or add very large third-party addons (raises limit to 5 GB).
# VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# --- 4. Odoo Runtime Tuning for Serverless -----------------------------------
# Keep db_maxconn low (3-6) so concurrent Vercel instances don't exhaust Supabase pooler
ODOO_DB_MAXCONN=4
# Master password (DB manager is disabled by default with list_db=False)
ODOO_ADMIN_PASSWD=change-me-to-a-strong-random-password
# Comma-separated server-wide modules (keep base,web,vercel_supabase)
ODOO_SERVER_WIDE_MODULES=base,web,vercel_supabase
# Optional log level: info, warn, error, debug
ODOO_LOG_LEVEL=info
# Optional custom base URL (e.g., https://erp.yourdomain.com)
# ODOO_BASE_URL=

# --- 5. Serverless PDF Engine (Quotations, Pro-Forma Invoices & Invoices) ----
# Modes:
#   auto        -> uses ODOO_PDF_SERVICE_URL if set, else wkhtmltopdf if installed,
#                  else built-in pure-Python xhtml2pdf (default on Vercel!)
#   xhtml2pdf   -> force built-in pure-Python xhtml2pdf (zero external services)
#   service     -> force external Chromium PDF service (pixel-perfect Bootstrap 5)
ODOO_PDF_ENGINE=auto
# Optional external Chromium PDF service (e.g. Gotenberg / Browserless / Cloudflare):
# ODOO_PDF_SERVICE_URL=https://your-gotenberg-or-browserless-endpoint
# ODOO_PDF_SERVICE_TYPE=gotenberg
# ODOO_PDF_SERVICE_TOKEN=

# --- 6. Protected Platform Endpoints -----------------------------------------
# Vercel Cron automatically sends `Authorization: Bearer <CRON_SECRET>` to /api/cron
CRON_SECRET=replace-with-32-byte-random-hex

# One-time secret to protect POST /api/init-db (initialize or install modules in Supabase).
# Remove or unset this variable after your database is initialized!
ODOO_INIT_SECRET=replace-with-another-32-byte-random-hex
# Default admin credentials used only during initial POST /api/init-db
ODOO_DEFAULT_ADMIN_LOGIN=admin
ODOO_DEFAULT_ADMIN_PASSWORD=change-me-admin-password
ODOO_DEFAULT_LANG=en_US
# Pre-configured for Isange Hardware ERP (Command Center, Sales/POS, Stock, Fleet, Commercial Rentals & Invoicing)
ODOO_DEFAULT_MODULES=base,web,contacts,sale_management,purchase,stock,account,point_of_sale,fleet,maintenance,hr_expense,isange_property_fleet,zxs_entp_theme,vercel_supabase
